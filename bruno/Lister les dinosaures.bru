meta {
  name: Lister les dinosaures
  type: graphql
  seq: 4
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  query Dinosaurs {
    dinosaurs {
      id
      name
      displayName
      gender
      age
      eyesColor
      species {
        id
        name
      }
    }
  }
}

assert {
  res.status: eq 200
  res.body.errors: isUndefined
  res.body.data.dinosaurs: isArray
}

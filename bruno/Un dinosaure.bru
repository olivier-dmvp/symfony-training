meta {
  name: Un dinosaure
  type: graphql
  seq: 6
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  query Dinosaur($id: ID!) {
    dinosaur(id: $id) {
      id
      name
      displayName
      species {
        name
        habitats
        feeding
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "1"
  }
}

assert {
  res.status: eq 200
  res.body.errors: isUndefined
  res.body.data.dinosaur.id: eq "1"
}

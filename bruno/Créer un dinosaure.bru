meta {
  name: Créer un dinosaure
  type: graphql
  seq: 8
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:graphql {
  mutation CreateDinosaur($input: CreateDinosaurInput!) {
    createDinosaur(input: $input) {
      id
      name
      displayName
      species {
        name
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "name": "Bruno-{{$timestamp}}",
      "gender": "Male",
      "speciesId": "3",
      "age": 12,
      "eyesColor": "#00ff00"
    }
  }
}

assert {
  res.status: eq 200
  res.body.errors: isUndefined
  res.body.data.createDinosaur.name: startsWith Bruno-
}

script:post-response {
  bru.setVar("dinosaurId", res.body.data?.createDinosaur?.id);
}
